    "motion-v": "^2.8.0",
    "ngeohash": "^0.6.3",
    "nuxt-auth-utils": "^0.5.32",
    "nuxt-authorization": "^0.3.5",
    "nuxt-security": "^2.6.0",
    "nuxt-umami": "https://github.com/bgervan/nuxt-umami/releases/download/v3.4.0-bg.2/nuxt-umami-3.4.0.tgz",
    "oxc-parser": "^0.131.0",
