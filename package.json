{
  "name": "nuxt-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build && node scripts/ai-ready-db-init.mjs",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "start": "node .output/server/index.mjs",
    "postinstall": "nuxt prepare",
    "task": "nitro task list",
    "lint": "pnpx oxlint && pnpx eslint",
    "lint:ox": "oxlint --deny-warnings -D correctness -D suspicious -D perf && eslint --max-warnings 0 .",
    "lint:fix": "eslint . --fix",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:up": "drizzle-kit up",
    "db:analyze": "tsx scripts/analyze-db.ts",
    "db:sync-prod": "bash scripts/sync-prod-to-dev.sh",
    "db:studio": "drizzle-kit studio",
    "seed": "tsx server/db/seed.ts",
    "instantiate:locale": "tsx scripts/instantiate-locale.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:nuxt": "vitest run --project nuxt",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "bench:queries": "tsx --tsconfig tsconfig.json scripts/bench-queries.ts",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
